{
  "extends": "./tsconfig.json",
  "include": ["server/**/*", "shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
